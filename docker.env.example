# Секреты Docker-версии (см. docs/BACKEND.md).
#   cp docker.env.example docker.env
# docker.env в git не попадает. Значения — те же, что в Vercel → Settings → Environment Variables.
# Адрес базы задавать НЕ нужно: он прописан в compose.yaml.

# Заявки → Bitrix24: https://<портал>.bitrix24.kz/rest/<пользователь>/<код>/
BITRIX_WEBHOOK_URL=
# BITRIX_DEAL_CATEGORY_ID=
# BITRIX_DEAL_STAGE_ID=
# BITRIX_STATUS_ID=
# BITRIX_SOURCE_ID=
# BITRIX_ASSIGNED_BY_ID=

# Кабинет результатов (/results): обязательно
# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (если оставить прежнюю — сессии родителей на сайте не сбросятся)
RESULTS_SESSION_SECRET=
# Письма с паролями отправляет Resend: домен должен быть подтверждён в Resend
RESEND_API_KEY=
MAIL_FROM=Fibonacci Olympiad <results@fibonacci-olympiads.kz>
